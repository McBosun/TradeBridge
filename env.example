# Copy to .env for local use. On Render, add these under Environment instead.
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require
JWT_SECRET=use-a-random-string-of-at-least-32-characters
ALLOWED_ORIGIN=https://mcbosun.github.io

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Only if your bucket uses a jurisdiction (EU or FedRAMP), paste the endpoint Cloudflare shows, no bucket name:
R2_ENDPOINT=
R2_BUCKET=tradebridge-photos
R2_PUBLIC_URL=https://photos.yourdomain.com

# Only for the first deploy, then delete ADMIN_PASSWORD:
ADMIN_EMAIL=
ADMIN_PASSWORD=
